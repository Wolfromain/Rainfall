#include <stdlib.h>
#include <string.h>
#include <stdio.h>
#include <unistd.h>

int language = 0;

int main(int argc, char **argv)
{
	char *buffer[76];

	if (argc != 3)
		return(1);

	memset(buffer, 0, 76);
	strncpy(buffer, argv[1], 40);
	strncpy(buffer, argv[2], 32);
	char *env = getenv("LANG");

	if (env != 0)
	{
		if (memcmp(env, "fi", 2) == 0)
			language = 1;
		else if (memcmp(env, "nl", 2) == 0)
			language = 2
	}
	greetuser(buffer);
	return(0);
}

void greetuser(char *buf)
{
	char *buffer[72];

	if (language == 1)
		strcpy(buffer, "Hyvää päivää ");

	else if (language == 2)
		strcpy(buffer, "Goedemiddag! ");

	else if (language == 0)
		strcpy(buffer, "Hello ");

	strcat(buffer, buf);
	puts(buffer);
}