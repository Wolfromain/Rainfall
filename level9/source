#include <stdlib.h>
#include <string.h>
#include <stdio.h>

class N
{
	private :
		void *vtable;
		char annotation[100];
		int x;

	public :
		N(int arg)
		{
			this->vtable = (void *)0x8048848;
			this->x = arg;
		};
		~N()	{}
		void setAnnotation(char *s)
		{
			annotation = memcpy((char *)this + 4, s, strlen(s));
		};
		int operator+(N &n)
		{
			return this->x + n.x;
		};
		int operator-(N &n)
		{
			return this->x - n.x;
		};
};


int main(int argc, char **argv)
{
	if(argc <= 1)
		exit(1);

	N *obj1 = new N(5);
	N *obj2 = new N(6);

	obj1->setAnnotation(argv[1]);
	return(*obj2 + *obj1);


}
